{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rychlevypocty-v3-preview",
  "main": "cloudflare/preview-worker.mjs",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
