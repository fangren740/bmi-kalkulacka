{
  "version": 2,
  "site_origin": "https://rychlevypocty.cz",
  "sitemap": "sitemap.xml",
  "robots": "robots.txt",
  "scan": {
    "exclude_dirs": [
      ".git",
      ".github",
      "audits",
      "node_modules"
    ],
    "exclude_files": []
  },
  "dataset": {
    "description_min": 50,
    "description_max": 5000
  },
  "live": {
    "sitemap_url": "https://rychlevypocty.cz/sitemap.xml",
    "robots_url": "https://rychlevypocty.cz/robots.txt",
    "minimum_sitemap_urls": 150,
    "check_repo_sitemap_parity": true,
    "check_assets": true,
    "timeout_seconds": 12,
    "retries": 2,
    "retry_delay_seconds": 2,
    "workers": 12,
    "redirect_alias_origins": [
      "https://www.rychlevypocty.cz"
    ]
  },
  "release": {
    "blocking_severities": [
      "P0",
      "P1"
    ]
  },
  "exceptions": [],
  "seo": {
    "forbidden_origins": [
      "https://www.rychlevypocty.cz",
      "http://www.rychlevypocty.cz",
      "http://rychlevypocty.cz"
    ]
  }
}
