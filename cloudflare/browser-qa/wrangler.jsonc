{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rv3-browser-qa",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "browser": {
    "binding": "QA_BROWSER"
  },
  "ratelimits": [
    {
      "name": "QA_RUN_LIMIT",
      "namespace_id": "271164",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "kv_namespaces": [
    {
      "binding": "QA_EVIDENCE",
      "id": "7380bb0e1f204b42af9f24e138ccacb3"
    }
  ],
  "preview_urls": false
}
